[Macros]
OpenAAUseLibrary=$ENV{HOME}/OpenAA-OtherLibrary
LOCKSTAR=
LIBXLSXWRITER=$ENV{HOME}/OpenAA-OtherLibrary/LibXLSXWriter/libxlsxwriter/
OPENXLSX=$ENV{HOME}/OpenAA-OtherLibrary/OpenXLSX/OpenXLSX/
FFTW=$ENV{HOME}/OpenAA-OtherLibrary/FFTW/fftw-3.3.10/
ZXING=$ENV{HOME}/OpenAA-OtherLibrary/Barcode/zxing-cpp/
Qt_LIBPATH_=
tesseract=$ENV{HOME}/OpenAA-OtherLibrary/OCR/tesseract/
FREETYPE=$ENV{HOME}/OpenAA-OtherLibrary/FreeType/freetype-2.14.3/
XPDF=$ENV{HOME}/OpenAA-OtherLibrary/PDF/xpdf-4.06/
VCInstallDir=
Qt_INCLUDEPATH_=
OpenGL=
SAPERA=
Qt_LIBS_=
DDK=
WD_BASEDIR=
HALCONROOT=
ZLib=
[IncludeDirs]
$ENV{HOME}/OpenAA-OtherLibrary/OpenXLSX/OpenXLSX/OpenXLSX
$ENV{HOME}/OpenAA-OtherLibrary/OpenXLSX/OpenXLSX/build/OpenXLSX/
x64/Release/qt
x64/Release/qt/uic
[LibraryDirs]
/usr/local/lib/
$ENV{HOME}/OpenAA-OtherLibrary/OpenXLSX/OpenXLSX/lib/
$ENV{HOME}/OpenAA6/Lib/Release
[OptimizationFlags]
-O0
-g
[ExcludedLibraries]
mpr.lib
comctl32.lib
ws2_32.lib
version.lib
Psapi.Lib
zlibstat.lib
LibJpeg.lib
[AdditionalLibraryFiles]
libpng16.so
libForWindows.a
${CMAKE_CURRENT_SOURCE_DIR}/../libNetworkDrive.so
${CMAKE_CURRENT_SOURCE_DIR}/../../libNetworkDrive.so
${CMAKE_CURRENT_SOURCE_DIR}/../../../libNetworkDrive.so
${CMAKE_CURRENT_SOURCE_DIR}/../../../../libNetworkDrive.so
z
pugixml
miniz
[LinkOptions]
[BuildSettings]
EnableParallelBuild=0
MaxParallelBuilds=0
ModeDynamicLink=0
ForceOpenMP=1
